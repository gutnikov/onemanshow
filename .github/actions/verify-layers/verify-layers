#!/bin/sh
# Checks that a destination-labelled derivative is the artifact that was built.
#
# This is the promotion invariant. It used to be a comparison of one image
# digest; since a derivative must carry destination metadata the digests
# necessarily differ, so what is compared is the layer list - the bits that
# actually run.
set -eu
IMAGE="${1:?usage: verify-layers <image> <base-tag> <derived-tag>...}"
BASE="${2:?}"
shift 2

layers() {
  docker buildx imagetools inspect --raw "${IMAGE}:$1" > /tmp/vl.json
  if grep -q '"manifests"' /tmp/vl.json; then
    d=$(python3 -c "import json;print(json.load(open('/tmp/vl.json'))['manifests'][0]['digest'])")
    docker buildx imagetools inspect --raw "${IMAGE}@${d}" > /tmp/vl.json
  fi
  python3 -c "import json;print(' '.join(l['digest'] for l in json.load(open('/tmp/vl.json')).get('layers',[])))"
}

want="$(layers "$BASE")"
[ -n "$want" ] || { echo "no layers found for ${IMAGE}:${BASE}"; exit 1; }
echo "base ${BASE}: $(echo "$want" | wc -w | tr -d ' ') layers"

for tag in "$@"; do
  got="$(layers "$tag")"
  if [ "$got" = "$want" ]; then
    echo "  ${tag}: identical layers"
  else
    echo "  ${tag}: LAYERS DIFFER from the validated image" >&2
    exit 1
  fi
done
