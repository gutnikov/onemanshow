#!/bin/sh
# A new commit on a change, and what that invalidates.
#
# The point is not "dev -> staging". It is that a new commit means the validated
# artifact is no longer this change's head, so whatever the change had earned on
# the old commit it has not earned on this one.
#
# Three states react. The third closes a hole: an approval applied to one commit
# stayed applied while the head moved underneath it, and the approval guard -
# which checks that a person applied the label, not which commit they were
# looking at - would have read as satisfied.
set -eu

TICKET="${1:?usage: promote-to-staging <ticket> <sha>}"
SHA="${2:?}"
STATUS="${TICKET_STATUS:-}"
WORKFLOW="${STAGING_WORKFLOW:-on-staging.yml}"

# Checked before anything is moved. Validating input after mutating state leaves
# the state changed and the work not done.
case "$SHA" in
  ????????????????????????????????????????) : ;;
  *) echo "::error::sha must be a full 40-character commit, got '${SHA}'"; exit 1 ;;
esac

# An empty status is not a state, it is a broken ticket. Treating it as "some
# other status, nothing to do" is how this reported success while doing nothing:
# the status had failed to parse, and silence read as a legitimate no-op.
if [ -z "$STATUS" ]; then
  echo "::error::ticket #${TICKET} carries no status label, so it is not in the lifecycle - a change with a pull request must have one"
  exit 1
fi

note=""
case "$STATUS" in
  dev)
    gh issue edit "$TICKET" --remove-label status:dev --add-label status:staging
    echo "ticket #${TICKET}: dev -> staging"
    note="Checks and the build passed on \`${SHA}\`. Moved to \`staging\` and started the validation — two runs: migration safety against production's data, then the full suite against fixtures seeded at this commit.

Nobody asked for this; it is the transition the lifecycle assigns to automation. The next thing that needs a person is approval, and it will be asked for here with the stand's address."
    ;;
  staging)
    echo "ticket #${TICKET} is already in staging and its head moved - revalidating"
    note="A new commit arrived while this was on the stand, so the earlier validation no longer describes what is here. Revalidating \`${SHA}\`.

Nothing was approved yet, so nothing is being taken away."
    ;;
  ready-to-release)
    gh issue edit "$TICKET" --remove-label status:ready-to-release --add-label status:staging
    echo "ticket #${TICKET}: ready-to-release -> staging, approval no longer applies"
    note="A new commit arrived after this was approved, so the approval no longer applies to what is here — it was given for a commit that is no longer the head. Back to \`staging\` and revalidating \`${SHA}\`.

The approval guard checks that a person applied the label, not which commit they were looking at, so leaving the label in place would have let an unapproved commit through a guard that reads as satisfied."
    ;;
  *)
    echo "ticket #${TICKET} is in '${STATUS}' - not a state that a new commit revalidates"
    exit 0
    ;;
esac

# Dispatched rather than called: the staging validation needs the machine's
# address and host key, which this workflow has no reason to know.
gh workflow run "$WORKFLOW" -f sha="$SHA"
echo "staging validation dispatched for ${SHA}"
gh issue comment "$TICKET" --body "$note"
