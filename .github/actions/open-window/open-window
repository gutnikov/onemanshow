#!/bin/sh
# ready-to-release -> released, and the observation window opens.
#
# The window is the interval in which a change is `released` and not yet
# closed, so this transition is what starts it. Nothing else marks the
# beginning: a release run's timestamp records when a deploy happened, and the
# window is about what has been true since.
set -eu

TICKET="${1:?usage: open-window <ticket> <sha> <outcome>}"
SHA="${2:?}"
OUTCOME="${3:?}"
STATUS="${TICKET_STATUS:-}"
RUN="${RUN_URL:-}"
WINDOW="${OBSERVATION_WINDOW:-the configured window}"

case "$OUTCOME" in
  success)
    [ "$STATUS" = ready-to-release ] || [ "$STATUS" = released ] || {
      echo "ticket #${TICKET} is in '${STATUS:-none}' - a release landed for a change that was not waiting to release, leaving it alone"
      exit 0
    }
    if [ "$STATUS" = released ]; then
      echo "ticket #${TICKET} is already released - the window is open"
      exit 0
    fi
    gh issue edit "$TICKET" --remove-label status:ready-to-release --add-label status:released
    gh issue comment "$TICKET" --body "$(printf '%s' "\
## Released — the observation window is open

Production is running \`${SHA}\`, the artifact that passed staging, promoted rather than rebuilt.

**This ticket stays open for ${WINDOW}.** That is not an oversight: a change that is released and not yet closed is exactly what \"still under observation\" means, so the open ticket *is* the window. It closes itself when the window elapses and every configured source has been asked.

Run: ${RUN}")"
    echo "ticket #${TICKET}: ready-to-release -> released, window open"
    ;;
  *)
    # What production is now, said rather than assumed. The old version of this
    # message asserted that nothing had been rolled back on every failure,
    # including the failures that had just rewound production - it was telling
    # the reader the opposite of what happened, at the moment they were deciding
    # what to do about it.
    case "${PRODUCTION:-}" in
      untouched)
        WHERE="**Production was not touched.** The release stopped before migrating or deploying, so there is nothing to undo. The likely causes are the stored credentials or a production that was already unwell — not this change."
        ;;
      migrated)
        WHERE="**The schema moved and the deploy did not happen.** Production is running the previous image against a schema that has advanced past it, which readiness refuses to call healthy. Going forward is the way out; rewinding is not, because there is nothing to rewind to that fits this schema."
        ;;
      deployed)
        WHERE="**Production is running the new artifact and nothing was rolled back.** Rewinding restores neither the configuration nor the schema, so it is not the safe default it appears to be — and if the migration has already run, the previous image may not work against the schema it finds, which turns \"step back until it works\" into a cascade that never terminates."
        ;;
      rewound)
        WHERE="**Production was rewound to the previous artifact, and the release still failed.** So the previous version did not pass verification either, and stepping further back is not the answer: whatever is wrong is not the image."
        ;;
      *)
        WHERE="**What happened to production was not reported.** Ask it directly rather than assuming either way — that is the whole reason this sentence is derived and not guessed."
        ;;
    esac
    gh issue edit "$TICKET" --add-label blocked:rollback 2>/dev/null || true
    gh issue comment "$TICKET" --body "$(printf '%s' "\
## The release failed on \`${SHA}\`

Marked \`blocked:rollback\`. Run: ${RUN}

${WHERE}

This needs reading, not reflex. Say the word.")"
    echo "ticket #${TICKET}: release failed, blocked:rollback, production ${PRODUCTION:-unreported}"
    ;;
esac
