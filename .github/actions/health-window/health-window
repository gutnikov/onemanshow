#!/bin/sh
# Answers one question: has production been healthy since this release deployed?
#
# It asks about *new issues in this release* rather than an error rate, because
# an indie product has almost no traffic: one error in three requests is a 33%
# rate, and a quiet window may only mean nobody visited. "Did anything break
# that was not broken before" survives any traffic volume.
#
# Every source is optional and says so when absent. A check that silently
# degrades to "fine" is worse than no check, so an unconfigured source is
# reported as unchecked and never counted as healthy.
set -eu

ORG="${SENTRY_ORG:-}"
# Issues are attributed to a release, and both environments run the same
# release - so without an environment filter an error deliberately raised on
# staging counts against production's window. Observed exactly that.
ENVIRONMENT="${SENTRY_ENVIRONMENT:-production}"
PROJECT="${SENTRY_PROJECT:-}"
RELEASE="${1:?usage: health-window <release-sha>}"
SMOKE="${SMOKE_RESULT:-unknown}"

verdict=healthy
say() { printf '%s\n' "$*"; }
unhealthy() { verdict=unhealthy; say "  UNHEALTHY: $1"; }

say "release ${RELEASE} in ${ENVIRONMENT}"

# --- smoke, from the deploy that put this release live -----------------------
case "$SMOKE" in
  success) say "  smoke: passed" ;;
  failure) unhealthy "smoke failed after deploy" ;;
  *)       say "  smoke: not reported" ;;
esac

# --- new issues attributed to this release -----------------------------------
if [ -n "$ORG" ] && [ -n "$PROJECT" ] && [ -n "${SENTRY_READ_TOKEN:-}" ]; then
  url="https://sentry.io/api/0/projects/${ORG}/${PROJECT}/issues/?query=is%3Aunresolved+first-release%3A${RELEASE}&environment=${ENVIRONMENT}&statsPeriod=24h"
  if ! body="$(curl -sS -f -H "Authorization: Bearer ${SENTRY_READ_TOKEN}" "$url")"; then
    unhealthy "could not reach error tracking - treat as unknown, not as fine"
  else
    count="$(printf '%s' "$body" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')"
    if [ "$count" -gt 0 ]; then
      unhealthy "$count unresolved issue(s) first seen in this release"
      printf '%s' "$body" | python3 -c '
import json, sys
for issue in json.load(sys.stdin)[:5]:
    title = issue["title"][:90]
    events = issue["count"]
    print("    - " + title + "  (" + str(events) + " events)")'
    else
      say "  errors: no new issues in this release"
    fi
  fi
else
  say "  errors: not checked (error tracking is not configured)"
fi

# --- liveness, which must come from outside the machine ----------------------
#
# An absent monitor and a healthy one both report zero downtime events, so
# absence must not be inferred from silence. The configuration asserts that a
# monitor exists; without that assertion this stays unchecked.
case "${LIVENESS_SOURCE:-}" in
  sentry-uptime)
    if [ -z "${SENTRY_READ_TOKEN:-}" ] || [ -z "$ORG" ] || [ -z "$PROJECT" ]; then
      unhealthy "liveness is declared but cannot be queried - treat as unknown"
    else
      # The declaration is verified against the world, not trusted. This file
      # once said no monitor was configured while one had been running for
      # hours, and the window was reported as resting on two sources when it
      # rested on three. A hand-maintained assertion about an external service
      # drifts, and the drift silently weakens the check.
      if ! mon="$(curl -sS -f -H "Authorization: Bearer ${SENTRY_READ_TOKEN}" \
                   "https://sentry.io/api/0/organizations/${ORG}/uptime/")"; then
        unhealthy "liveness is declared but the monitor list could not be read - treat as unknown"
        mon=""
      else
        lag="$(printf '%s' "$mon" | ENVIRONMENT="$ENVIRONMENT" PROJECT="$PROJECT" python3 -c '
import json, os, sys
env, project = os.environ["ENVIRONMENT"], os.environ["PROJECT"]
active = [m for m in json.load(sys.stdin)
          if m.get("projectSlug") == project
          and m.get("environment") == env
          and m.get("status") == "active"]
if not active:
    print("NONE")
else:
    m = active[0]
    every = int(m.get("intervalSeconds", 0))
    fails = int(m.get("downtimeThreshold", 0))
    url = m.get("url", "?")
    print(str(every * fails // 60) + "m " + str(every // 60) + "m " + str(fails) + " " + url)')"
        if [ "$lag" = NONE ]; then
          unhealthy "liveness is declared as ${LIVENESS_SOURCE} but no active monitor exists for ${PROJECT}/${ENVIRONMENT} - the declaration is stale"
        fi
      fi

      url="https://sentry.io/api/0/projects/${ORG}/${PROJECT}/issues/?query=is%3Aunresolved+issue.category%3Auptime&environment=${ENVIRONMENT}&statsPeriod=24h"
      if ! body="$(curl -sS -f -H "Authorization: Bearer ${SENTRY_READ_TOKEN}" "$url")"; then
        unhealthy "could not reach the uptime monitor - treat as unknown, not as fine"
      else
        downs="$(printf '%s' "$body" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')"
        if [ "$downs" -gt 0 ]; then
          # Downtime is reported separately from code defects on purpose: they
          # are different failures with different remedies.
          unhealthy "$downs downtime event(s) reported by the external monitor"
        elif [ "$lag" != NONE ] && [ -n "$lag" ]; then
          # Derived from the monitor, never from a number written here. The
          # figure in this message was wrong within hours of being written,
          # because the interval was changed and the sentence was not.
          set -- $lag
          say "  liveness: no downtime reported, monitoring $4"
          say "            detection takes up to ~$1 (every $2, $3 failures to declare),"
          say "            so an outage starting within $1 of the window closing"
          say "            is not caught before it closes"
        else
          say "  liveness: no downtime reported"
        fi
      fi
    fi
    ;;
  "")
    say "  liveness: NOT CHECKED - no external monitor is declared, so the one"
    say "            signal that survives the machine dying is missing"
    # Check the other direction too. A monitor that exists while the
    # configuration denies it takes no part in this decision, and that is
    # worse than having none, because someone believes they are covered.
    if [ -n "$ORG" ] && [ -n "$PROJECT" ] && [ -n "${SENTRY_READ_TOKEN:-}" ]; then
      if mon="$(curl -sS -f -H "Authorization: Bearer ${SENTRY_READ_TOKEN}" \
                 "https://sentry.io/api/0/organizations/${ORG}/uptime/")"; then
        found="$(printf '%s' "$mon" | ENVIRONMENT="$ENVIRONMENT" PROJECT="$PROJECT" python3 -c '
import json, os, sys
env, project = os.environ["ENVIRONMENT"], os.environ["PROJECT"]
print(len([m for m in json.load(sys.stdin)
           if m.get("projectSlug") == project and m.get("environment") == env
           and m.get("status") == "active"]))')"
        if [ "$found" -gt 0 ]; then
          unhealthy "$found active monitor(s) exist for ${PROJECT}/${ENVIRONMENT} but the configuration declares none, so liveness took no part in this verdict"
        fi
      fi
    fi
    ;;
  *)
    unhealthy "unknown liveness source: ${LIVENESS_SOURCE}"
    ;;
esac

say "verdict: ${verdict}"
[ "$verdict" = healthy ]
