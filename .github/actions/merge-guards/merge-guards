#!/bin/sh
# The six guards, read from the tools and reported one by one.
#
# Reported individually on purpose. An aggregate verdict tells you a merge was
# refused; it does not tell you which condition to go and fix, and the guard
# that gets forgotten is the one nobody can see the state of.
#
# None of these was enforced by anything before this existed. All six were
# satisfied on 2026-08-25 and none was checked - they held because the person
# merging read them.
set -eu

TICKET="${1:?usage: merge-guards <ticket> <head-sha>}"
HEAD="${2:?}"
REPO="${GITHUB_REPOSITORY:?}"
TRIGGER="${RELEASE_WORKFLOW:-.github/workflows/on-main.yml}"
IGNORE="$("${ACTION_DIR}/deployable-excludes.py" "$TRIGGER")"
failed=0
ok()   { printf '  PASS  %-28s %s\n' "$1" "$2"; }
bad()  { printf '  FAIL  %-28s %s\n' "$1" "$2"; failed=$((failed+1)); }

# --- 1. approval recorded, by a person ---------------------------------------
# The label carries the approval, so the question is who applied it. If
# automation could apply it, the reservation of approval to a person would be
# decoration - so the actor is checked, not just the label.
# Three questions, not one, and the two new ones exist because this guard used
# to be propped up by the event that triggered it. Reading the timeline alone
# certifies that a person approved *something*: the record survives the label
# being removed, so approve, push a commit, let automation drop the label to
# staging and let revalidation write a fresh mark on the new head - and every
# guard held for a commit nobody approved. On the event path the trigger itself
# was the missing proof. A path a person can take by hand has no such trigger,
# so the proof has to be here.
approval="$(gh api "repos/${REPO}/issues/${TICKET}/timeline" --paginate \
          -q '[.[] | select(.event == "labeled" and .label.name == "status:ready-to-release")] | last | "\(.actor.login) \(.created_at)"' \
          2>/dev/null || true)"
actor="${approval%% *}"
approved_at="${approval##* }"

# Is the label there now, or only in the record of having been there?
still_labelled="$(gh api "repos/${REPO}/issues/${TICKET}/labels" \
                  -q '[.[].name] | index("status:ready-to-release") // "no"' 2>/dev/null || echo no)"

# Is the approval newer than what it would be approving? This is the cheap
# version of a commit-scoped approval, chosen deliberately: it closes the
# sequence above, because after a push the newest approval is older than the
# head. It leaves a narrower race - approve and push inside the same second -
# which a mark written on the head itself would close, and which is a later
# change.
head_at="$(git show -s --format=%cI "$HEAD" 2>/dev/null || true)"
newer=unknown
if [ -n "$approved_at" ] && [ -n "$head_at" ]; then
  newer="$(python3 -c 'import sys; from datetime import datetime; a,h=(datetime.fromisoformat(x.replace("Z","+00:00")) for x in sys.argv[1:3]); print("yes" if a>h else "no")' "$approved_at" "$head_at" 2>/dev/null || echo unknown)"
fi

case "$actor" in
  "" | null)          bad approval "no record of the ready-to-release label being applied" ;;
  *"[bot]" | *"-bot") bad approval "applied by ${actor}, which is not a person" ;;
  *)
    if [ "$still_labelled" = no ]; then
      bad approval "applied by ${actor} once, but the label is not on the ticket now - a new commit withdraws approval, and the record of it does not"
    elif [ "$newer" = no ]; then
      bad approval "applied by ${actor} at ${approved_at}, older than ${HEAD} (${head_at}) - approved a different commit"
    elif [ "$newer" = unknown ]; then
      bad approval "could not compare the approval to the commit it would approve - unknown is not agreement"
    else
      ok approval "applied by ${actor} at ${approved_at}, after ${head_at}"
    fi
    ;;
esac

# --- 2. the pipeline green on THIS commit ------------------------------------
# Read from the mark the validation wrote, not from a run's own commit: a
# dispatched run reports the branch it was dispatched from.
if "${ACTION_DIR}/../validation-mark/validation-mark" check "$HEAD" >/dev/null 2>&1; then
  ok validated "$HEAD passed both staging runs"
else
  bad validated "$HEAD carries no record of passing staging validation"
fi

# --- 3. a fast-forward is possible ------------------------------------------
git fetch -q origin main
if git merge-base --is-ancestor origin/main "$HEAD"; then
  ok fast-forward "main is an ancestor of $HEAD"
else
  bad fast-forward "main has moved since $HEAD was validated - revalidate rather than rebuild"
fi

# --- 4. production equals the last deployable commit ------------------------
# shellcheck disable=SC2086
lastdep="$(git log -1 --format=%H origin/main -- . $IGNORE)"
# Asked of production itself. A deploy log or a workflow run records what was
# intended, and a rollback is exactly when intent and reality differ - which is
# the case this guard exists for. The alternative was a shell connection to the
# machine, which would answer correctly and would hand the guard the
# credentials that can deploy, to learn a fact the artifact knows about itself.
running="${PRODUCTION_COMMIT:-}"
if [ -z "$running" ] && [ -n "${PRODUCTION_HEALTH_URL:-}" ]; then
  running="$("${ACTION_DIR}/../production-commit/production-commit" \
              "$PRODUCTION_HEALTH_URL" 2>/dev/null || true)"
fi
if [ -z "$running" ]; then
  bad production "production did not report what it is running - unknown is not agreement"
elif [ "$running" = "$lastdep" ]; then
  ok production "running $running, the last deployable commit"
else
  bad production "running ${running}, last deployable is ${lastdep} - unresolved rollback or a leaked release"
fi

# --- 5. no other change still under observation ------------------------------
others="$(gh issue list --state open --label status:released --json number \
            -q "[.[] | select(.number != ${TICKET})] | length")"
if [ "$others" -eq 0 ]; then
  ok observation "no other change is in released"
else
  bad observation "${others} other change(s) in released with an open window"
fi

# --- 6. no active incident ---------------------------------------------------
blocked="$(gh issue list --state open --json number,labels \
            -q '[.[] | select(any(.labels[].name; startswith("blocked:")))] | length')"
if [ "$blocked" -eq 0 ]; then
  ok incident "no ticket carries a blocked label"
else
  bad incident "${blocked} ticket(s) blocked - resolve before shipping another change"
fi

echo
if [ "$failed" -gt 0 ]; then
  echo "::error::${failed} of 6 merge guards refused"
  exit 1
fi
echo "all 6 guards hold"
