node_modules/
dist/
web/dist/
test-results/
playwright-report/
.env
.env.*
!.env.example
*.log
.DS_Store

# Key material and anything decrypted to a separate file. The sops-encrypted
# secrets/*.yaml files themselves ARE committed - that is the point of them.
*.agekey
*.dec
*.dec.yaml

# Kamal state is local; its secrets files hold references, not values, so they
# are committed on purpose - CI needs them.
.kamal/*
!.kamal/secrets
!.kamal/secrets-common
