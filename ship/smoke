#!/bin/sh
# The tagged subset, run against production. Non-mutating by construction: it
# exercises real pages, which is the failure a liveness check cannot see.
#
# Installs its own browser for the same reason ship/e2e does.
set -eu
: "${SHIP_URL:?SHIP_URL is not set}"
npx playwright install --with-deps chromium
npx playwright test --grep @smoke
