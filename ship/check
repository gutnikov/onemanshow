#!/bin/sh
# Everything that needs no running application. Anything requiring a live
# instance belongs in ship/e2e or ship/smoke instead.
set -eu
npm run typecheck
npm run lint
npm run test

# The journal and the files must agree. Nothing else compares them, and a
# mismatch only shows up when migrations run - by then it is a deploy.
python3 scripts/check-migrations.py

# The two secret-reference files must agree. They are the same list twice, and
# editing one and not the other kept a removed credential alive.
python3 scripts/check-kamal-secrets.py
